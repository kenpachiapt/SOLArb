# Loaded only by the bot service; never by the panel.
SOLANA_DRY_RUN=true
# To enable live mode deliberately: SOLANA_DRY_RUN=false and the following exact phrase.
ENABLE_LIVE_TRADING=
SOLANA_PUBLIC_ADDRESS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
JUPITER_REQUEST_INTERVAL_MS=1100
MAX_QUOTE_AGE_MS=10000
MAX_PRICE_IMPACT_PCT=1
MAX_TRADE_SOL=0.01
MAX_DAILY_RISK_SOL=0.05
MAX_TRADES_PER_DAY=3
MIN_RESERVE_SOL=0.02
MAX_FEES_SOL=0.001
MAX_SLIPPAGE_BPS=30
JITO_TIP_SOL=0.00001
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
